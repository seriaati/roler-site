---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Roler: Discord Role Panels as Chat Messages",
  description = "Create Discord role panels in chat. Write markdown, match roles by name, and edit live.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1824" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fragment+Mono&family=Hanken+Grotesk:wght@400;500;600;700&family=Recursive:wght,MONO@300..800,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
