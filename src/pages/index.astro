---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Playground from "../components/Playground.astro";
import Templates from "../components/Templates.astro";
import Details from "../components/Details.astro";
import End from "../components/End.astro";
---

<Layout>
  <main class="page">
    <Hero />
    <Playground />
    <Templates />
    <Details />
    <End />
  </main>

  <button class="sw" id="sw" type="button" aria-pressed="false"><i aria-hidden="true"></i><span class="sw-lbl"><span>Apps › Create Role Panel</span><span>Apps › Edit template</span></span></button>
</Layout>

<script>
  // Page-wide template ↔ panel state. Every .msg (the hero and the templates demo) compiles the
  // first time it scrolls into view; the pinned switch flips them all back to their markup.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const msgs = [...document.querySelectorAll<HTMLElement>(".msg")];
  const hero = document.getElementById("s1")!;
  const sw = document.getElementById("sw")!;
  let rendered = true;

  // tokens collapse from their measured width to 0, so they need a width to start from
  function measure() {
    document.querySelectorAll<HTMLElement>(".s1-tok, .s1-rtok").forEach(t => {
      t.style.maxWidth = "none";
      t.style.setProperty("--w", Math.ceil(t.scrollWidth + 2) + "px");
      t.style.maxWidth = "";
    });
  }
  document.addEventListener("roler:measure", measure);

  function setAll(on: boolean) {
    rendered = on;
    measure();
    for (const m of msgs) if (on ? m.dataset.seen : true) m.classList.toggle("ren", on);
    sw.setAttribute("aria-pressed", String(on));
  }
  sw.addEventListener("click", () => {
    // flipping back to the panel view compiles everything, including messages not scrolled to yet
    if (!rendered) for (const m of msgs) m.dataset.seen = "1";
    setAll(!rendered);
  });

  function checkSeen() {
    for (const m of msgs) {
      if (m.dataset.seen) continue;
      const r = m.getBoundingClientRect();
      if (r.top > innerHeight * 0.8 || r.bottom < 0) continue;
      m.dataset.seen = "1";
      if (rendered) setTimeout(() => m.classList.add("ren"), reduce ? 0 : 350);
    }
  }
  let ticking = false;
  addEventListener("scroll", () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { ticking = false; checkSeen(); });
  }, { passive: true });
  addEventListener("resize", checkSeen);

  // the hero types itself in as a template, then compiles into the page
  document.fonts.ready.then(() => {
    measure();
    hero.dataset.seen = "1";
    checkSeen();
    if (reduce) { setAll(true); return; }
    sw.setAttribute("aria-pressed", "true");
    hero.classList.add("typing");
    setTimeout(() => {
      hero.classList.remove("typing");
      if (rendered) hero.classList.add("ren");
    }, 1900);
  });
</script>
